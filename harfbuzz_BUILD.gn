import("//flutter/common/config.gni")

config("harfbuzz_config") {
  visibility = [ "//flutter/*", "//third_party/*" ]
  include_dirs = [ ".", "./src" ]
}

config("harfbuzz_internal_config") {
  visibility = [ ":*" ]
  defines = [
    "HB_NO_MT",
    # Remove HB_NO_UNICODE_FUNCS to enable ICU unicode functions
    # "HB_NO_UNICODE_FUNCS",
    "HB_NO_UCD",
    # Add these defines to enable ICU support
    "HAVE_ICU",
    "HAVE_ICU_BUILTIN",
  ]
  
  # Platform-specific configurations
  if (is_win) {
    defines += [
      "WIN32_LEAN_AND_MEAN=1",
      "VC_EXTRALEAN=1",
    ]
  }
}

