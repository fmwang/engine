  public_configs = [ ":harfbuzz_config" ]
  configs += [ ":harfbuzz_internal_config" ]

  deps = [
    "//third_party/icu",
  ]

  # Platform-specific sources and dependencies
  if (is_mac || is_ios) {
    sources += [
      "src/hb-coretext.cc",
    ]
  } else if (is_linux) {
    # Linux might need FreeType support
    deps += [
      "//third_party/freetype2",
    ]
  }

  # Exclude some files that might cause issues or are not needed
  if (!is_mac && !is_ios) {
    sources -= [ "src/hb-coretext.cc" ]
  }

  # Windows-specific source files handling
  if (!is_win) {
    sources -= [ "src/hb-directwrite.cc" ]
    sources -= [ "src/hb-uniscribe.cc" ]
  }

  if (!is_linux && !is_mac && !is_fuchsia) {
    sources -= [ "src/hb-glib.cc" ]
  }
}

# Create a static library target that can be used by other components
static_library("harfbuzz_static") {
  visibility = [ "//flutter/*", "//third_party/*" ]
  complete_static_lib = true
  public_deps = [ ":harfbuzz" ]
}